ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=av
 inabneogy.bits@gmail.com;X-NUM-GUESTS=0:mailto:avinabneogy.bits@gmail.com
