 1fef@group.calendar.google.com:mailto:c_4149d91b043a3a683b70c2b2b7697f98a8c
 57a6529c114eed60664456cea1fef@group.calendar.google.com
UID:3bea6banij6spmsnbmghe2e39n_R20250706T160000@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=av
 inabneogy.bits@gmail.com;X-NUM-GUESTS=0:mailto:avinabneogy.bits@gmail.com
